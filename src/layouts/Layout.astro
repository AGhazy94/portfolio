---
import { createHash } from 'node:crypto';
import { Font, getImage } from 'astro:assets';
import ScrollBar from '../components/ScrollBar.astro';
import { experience, profile, socials } from '../data/profile';
import { ogCard } from '../lib/graphics';
import '../styles/global.css';

interface Props {
  title?: string;
  noindex?: boolean;
}

const { title = profile.seoTitle, noindex: hidden = false } = Astro.props;
// Netlify sets PUBLIC_NOINDEX on deploy previews and branch deploys so only production is indexed.
const noindex = hidden || import.meta.env.PUBLIC_NOINDEX === 'true';
const siteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const { description } = profile;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
// LinkedIn and chat apps cache the card by URL, so a hash of its content makes them refetch when it changes.
const cardHash = createHash('sha256')
  .update(JSON.stringify(ogCard(new URL(process.env.URL ?? site.href).host)))
  .digest('hex')
  .slice(0, 8);
const ogImage = new URL(`/og.png?v=${cardHash}`, site);
const imageAlt = `${profile.name} — ${profile.title}`;
const current = experience[0];
const headshot = await getImage({ src: profile.portrait, width: 400, height: 400, format: 'jpg' });

const personId = new URL('/#person', site).href;
const websiteId = new URL('/#website', site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: site.href,
      name: profile.name,
      description: profile.description,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': canonical.href,
      url: canonical.href,
      name: title,
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId },
      dateCreated: profile.created,
      dateModified: profile.updated,
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      jobTitle: current.role,
      description: profile.description,
      url: site.href,
      image: new URL(headshot.src, site).href,
      email: `mailto:${profile.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: profile.location.city,
        addressCountry: profile.location.country,
      },
      worksFor: { '@type': 'Organization', name: current.company, url: current.href },
      alumniOf: { '@type': 'EducationalOrganization', name: profile.education.school },
      knowsAbout: profile.knowsAbout,
      knowsLanguage: profile.languages.map((language) => ({
        '@type': 'Language',
        name: language.name,
        alternateName: language.code,
      })),
      sameAs: socials.filter((social) => social.href.startsWith('http')).map((social) => social.href),
    },
  ],
};
// Escaped so copy containing "</script>" cannot end the JSON-LD block early.
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {siteVerification && <meta name="google-site-verification" content={siteVerification} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!hidden && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="profile:first_name" content={profile.name.split(' ')[0]} />
    <meta property="profile:last_name" content={profile.name.split(' ').slice(1).join(' ')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbfa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0b" />
    <meta name="color-scheme" content="light dark" />

    <!-- Runs before first paint so a stored theme never flashes the system one. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-geist" preload />
    {!hidden && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
  </head>
  <body class="bg-bg font-sans text-body antialiased selection:bg-accent selection:text-bg">
    <slot />
    <ScrollBar />
  </body>
</html>
