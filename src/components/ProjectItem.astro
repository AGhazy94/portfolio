---
import { Image } from 'astro:assets';
import CardHighlight from './CardHighlight.astro';
import Icon from './Icon.astro';
import Tags from './Tags.astro';
import { ui, type Project } from '../data/profile';

interface Props {
  item: Project;
}

const { name, href, summary, image, imageAlt, tags } = Astro.props.item;
---

<li class="mb-12">
  <div class="group relative grid gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:opacity-100! lg:group-hover/list:opacity-50">
    <CardHighlight />
    <div class="z-10 sm:order-2 sm:col-span-6">
      <h3>
        <a
          class="group/link inline-flex items-baseline text-base font-medium leading-tight text-slate-200 hover:text-teal-300 focus-visible:text-teal-300"
          href={href}
          target="_blank"
          rel="noreferrer noopener"
        >
          <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded-sm md:-inset-x-6 md:-inset-y-4 lg:block" />
          <span>
            {name}
            <Icon
              name="arrow-up-right"
              class="ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
            />
          </span>
          <span class="sr-only">{ui.newTab}</span>
        </a>
      </h3>
      <p class="mt-2 text-sm leading-normal">{summary}</p>
      <Tags tags={tags} />
    </div>
    <Image
      src={image}
      alt={imageAlt}
      widths={[200, 400, 600]}
      sizes="(min-width: 1280px) 140px, (min-width: 1024px) calc(13vw - 27px), (min-width: 640px) calc(25vw - 36px), 200px"
      class="aspect-video w-50 rounded-sm border-2 border-slate-200/10 object-cover object-top transition group-hover:border-slate-200/30 sm:order-1 sm:col-span-2 sm:w-full sm:translate-y-1"
      loading="lazy"
      decoding="async"
    />
  </div>
</li>
