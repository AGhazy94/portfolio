---
import ServiceRows from './ServiceRows.astro';
import { getServices } from '../lib/content';
import { ui } from '../data/profile';

const section = ui.sections.find(({ id }) => id === 'services')!;
const services = await getServices();
---

<section id={section.id} aria-labelledby="services-title" class="gutter scheme-band bg-band py-16 text-body md:py-20">
  <div class="mx-auto grid max-w-page gap-8 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <div>
      <h2 id="services-title" class="type-section text-fg">
        {section.title}
      </h2>
      <p class="mt-4 max-w-[36ch] text-reading leading-relaxed text-body">{ui.services.indexLead}</p>
    </div>
    <ServiceRows services={services} idPrefix="home-service" />
  </div>
</section>
