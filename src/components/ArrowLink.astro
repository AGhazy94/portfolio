---
import Icon from './Icon.astro';
import { ui } from '../data/profile';

interface Props {
  href: string;
  lead: string;
  last: string;
  external?: boolean;
}

const { href, lead, last, external = false } = Astro.props;
const underline =
  'border-b border-transparent pb-px transition group-hover/link:border-teal-300 motion-reduce:transition-none';
---

<a
  class="group/link inline-flex items-baseline text-base font-semibold leading-tight text-slate-200 hover:text-teal-300 focus-visible:text-teal-300"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer noopener' : undefined}
>
  <span>
    <span class={underline}>{lead} </span>
    <span class="whitespace-nowrap">
      <span class={underline}>{last}</span>
      <Icon
        name="arrow-right"
        class="ml-1 inline-block h-4 w-4 shrink-0 -translate-y-px transition-transform group-hover/link:translate-x-2 group-focus-visible/link:translate-x-2 motion-reduce:transition-none"
      />
    </span>
  </span>
  {external && <span class="sr-only">{ui.newTab}</span>}
</a>
