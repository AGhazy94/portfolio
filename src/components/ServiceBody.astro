---
import Icon from './Icon.astro';
import RichText from './RichText.astro';
import { ui } from '../data/profile';

interface Props {
  fit: string[];
  notFit?: string;
  gets: { title: string; text: string }[];
  steps: { title: string; text: string }[];
  experience: string[];
  terms: string[];
}

const { fit, notFit, gets, steps, experience, terms } = Astro.props;
const copy = ui.service;
// Every service ends its terms by asking for the brief, so that line sits beside the button.
const cta = terms.at(-1)!;

const section = 'mt-[clamp(56px,8cqi,96px)] grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-14';
const heading = 'type-project text-fg lg:sticky lg:top-24 lg:self-start';
const cardBase = 'rounded-card bg-surface p-[clamp(20px,3cqi,28px)]';
const prose = 'prose-page max-w-none';
---

<section aria-labelledby="fit-title" class={section}>
  <h2 id="fit-title" class={heading}>
    {copy.fit}
  </h2>
  <div>
    <ul class="max-w-[62ch] divide-y divide-divider border-y border-divider">
      {fit.map((item) => (
        <li class="flex items-start gap-3 py-4">
          <Icon name="check" class="mt-0.5 size-5 shrink-0 text-accent" />
          <RichText source={item} class="text-base leading-[1.6] text-body" />
        </li>
      ))}
    </ul>
    {notFit && <RichText source={notFit} class="mt-5 text-ui leading-[1.6] text-muted" />}
  </div>
</section>

<section aria-labelledby="gets-title" class="mt-[clamp(56px,8cqi,96px)]">
  <h2 id="gets-title" class="type-project text-fg">
    {copy.gets}
  </h2>
  <ul class:list={['mt-8 grid gap-[clamp(14px,3cqi,28px)] md:grid-cols-2', gets.length % 3 === 0 && 'lg:grid-cols-3']}>
    {gets.map((item) => (
      <li class={cardBase}>
        <h3 class="text-title-sm font-semibold text-fg">{item.title}</h3>
        <RichText source={item.text} class="mt-3 text-base leading-[1.6] text-body md:text-ui" />
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="steps-title" class="mt-[clamp(56px,8cqi,96px)]">
  <h2 id="steps-title" class="type-project text-fg">
    {copy.steps}
  </h2>
  <ol class="mt-8 grid gap-[clamp(14px,3cqi,28px)] md:grid-cols-2">
    {steps.map((item, index) => (
      <li class={cardBase}>
        <p class="text-caption font-medium text-muted">{`${copy.week} ${index + 1}`}</p>
        <h3 class="mt-1 text-title-sm font-semibold text-fg">{item.title}</h3>
        <RichText source={item.text} class="mt-3 text-base leading-[1.6] text-body md:text-ui" />
      </li>
    ))}
  </ol>
</section>

<section aria-labelledby="experience-title" class={section}>
  <h2 id="experience-title" class={heading}>
    {copy.experience}
  </h2>
  <div class="grid gap-4">
    {experience.map((paragraph) => (
      <RichText source={paragraph} class={prose} />
    ))}
  </div>
</section>

<section aria-labelledby="terms-title" class={section}>
  <h2 id="terms-title" class={heading}>
    {copy.terms}
  </h2>
  <div class="grid gap-4">
    {terms.slice(0, -1).map((paragraph) => (
      <RichText source={paragraph} class={prose} />
    ))}
    <div class="mt-4 flex flex-col gap-5 border-t border-fg pt-6 md:flex-row md:items-center md:justify-between md:gap-10">
      <RichText source={cta} class="max-w-[46ch] text-reading text-fg" />
      <a href="#contact" class="btn-pill min-h-12 w-full shrink-0 bg-fg text-bg md:w-auto">
        {ui.hero.contact}
      </a>
    </div>
  </div>
</section>
