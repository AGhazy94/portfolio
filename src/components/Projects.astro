---
import Icon from './Icon.astro';
import MetaLine from './MetaLine.astro';
import { projects, ui } from '../data/profile';

const section = ui.sections.find(({ id }) => id === 'projects')!;
---

<section id={section.id} aria-labelledby="projects-title" class="gutter border-t border-divider py-20 md:py-28">
  <div class="mx-auto max-w-page">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="projects-title" class="type-section text-fg">
        {section.title}
      </h2>
      <a
        href="/work/"
        class="inline-flex min-h-11 items-center text-ui font-medium text-accent underline underline-offset-4 hover:opacity-70"
      >
        {ui.work.homeMore}
      </a>
    </div>

    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, index) => (
        <li
          class:list={[
            'group relative flex flex-col rounded-card border border-divider bg-surface p-[clamp(24px,3.5cqi,32px)] transition-[translate,border-color] duration-300 hover:border-brand motion-safe:hover:-translate-y-1',
            // In two columns a last card on its own fills the row, so the grid never ends on an empty cell.
            projects.length % 2 === 1 && index === projects.length - 1 && 'md:col-span-2 lg:col-span-1',
          ]}
        >
          <div>
            {/* The logo repeats the h3's name, so Icon keeps it hidden from screen readers. */}
            {project.logo && <Icon name={project.logo} class="mb-6 block h-6 w-auto text-fg" />}
            <MetaLine text={project.kind} />
            <h3 class="type-project mt-1 text-balance text-fg">
              <a href={project.caseStudy} class="card-link">
                {project.name}
              </a>
            </h3>
          </div>
          <div class="flex flex-1 flex-col">
            <p class="mt-3 text-base leading-[1.65] text-body">{project.summary}</p>
            <p class="mt-4 text-caption leading-[1.6] text-muted">
              <span class="sr-only">{ui.tagsLabel}: </span>
              {project.tags.join(', ')}
            </p>
            <div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-1 pt-5 text-ui">
              <span aria-hidden="true" class="inline-flex min-h-11 items-center gap-1 font-medium text-accent">
                {ui.work.more}
                <Icon name="chevron" class="size-5 -rotate-90" />
              </span>
              {project.href && (
                <a
                  href={project.href}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="relative z-10 inline-flex min-h-11 items-center text-muted underline underline-offset-4 hover:text-fg"
                >
                  {ui.projects.visit}
                  <span class="sr-only">{ui.newTab}</span>
                </a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
