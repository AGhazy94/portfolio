---
import CardHighlight from './CardHighlight.astro';
import Icon from './Icon.astro';
import Tags from './Tags.astro';
import { ui, type Experience } from '../data/profile';

interface Props {
  item: Experience;
}

const { start, end, role, company, href, note, summary, tags } = Astro.props.item;
---

<li class="mb-12">
  <div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:opacity-100! lg:group-hover/list:opacity-50">
    <CardHighlight />
    <p class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-muted sm:col-span-2">
      <span aria-hidden="true">
        {start} — {end}
      </span>
      <span class="sr-only normal-case">{`${start} ${ui.dateTo} ${end}`}</span>
    </p>
    <div class="z-10 sm:col-span-6">
      <h3 class="font-medium leading-snug text-slate-200">
        {href ? (
          <a
            class="group/link inline-flex items-baseline text-base font-medium leading-tight text-slate-200 hover:text-teal-300 focus-visible:text-teal-300"
            href={href}
            target="_blank"
            rel="noreferrer noopener"
          >
            <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded-sm md:-inset-x-6 md:-inset-y-4 lg:block" />
            <span>
              {role} ·{' '}
              <span class="inline-block">
                {company}
                <Icon
                  name="arrow-up-right"
                  class="ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
                />
              </span>
            </span>
            <span class="sr-only">{ui.newTab}</span>
          </a>
        ) : (
          <span class="text-base leading-tight">
            {role} · {company}
          </span>
        )}
        {note && (
          <span class="block text-muted">
            <span class="sr-only">, </span>
            {note}
          </span>
        )}
      </h3>
      <p class="mt-2 text-sm leading-normal">{summary}</p>
      <Tags tags={tags} />
    </div>
  </div>
</li>
