---
import Icon from './Icon.astro';
import { profile, socials, ui } from '../data/profile';

interface Props {
  sections: { id: string; title: string }[];
}

const { sections } = Astro.props;
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:py-24">
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-slate-200 sm:text-5xl">
      <a href="/">{profile.name}</a>
    </h1>
    <p class="mt-3 text-lg font-medium tracking-tight text-slate-200 sm:text-xl">{profile.title}</p>
    <p class="mt-4 max-w-xs leading-normal">{profile.tagline}</p>

    <nav class="hidden lg:block" aria-label={ui.navLabel}>
      <ul class="mt-16 w-max">
        {sections.map(({ id, title }) => (
          <li>
            <a class="group flex items-center py-3" href={`#${id}`} data-nav-link={id}>
              <span class="mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-slate-200 group-focus-visible:w-16 group-focus-visible:bg-slate-200 group-data-active:w-16 group-data-active:bg-slate-200 motion-reduce:transition-none" />
              <span class="text-xs font-bold uppercase tracking-widest text-muted group-hover:text-slate-200 group-focus-visible:text-slate-200 group-data-active:text-slate-200">
                {title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <ul class="ml-1 mt-8 flex items-center" aria-label={ui.socialLabel}>
    {socials.map(({ label, href, icon }) => {
      const external = href.startsWith('http');
      return (
        <li class="mr-5 shrink-0 text-xs">
          <a
            class="-m-2.5 block p-2.5 hover:text-slate-200 focus-visible:text-slate-200"
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noreferrer noopener' : undefined}
          >
            <span class="sr-only">{external ? `${label}${ui.newTab}` : label}</span>
            <Icon name={icon} class="h-6 w-6" />
          </a>
        </li>
      );
    })}
  </ul>
</header>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.navLink!))
    .filter((section): section is HTMLElement => section !== null);
  const last = sections[sections.length - 1];

  let frame = 0;
  const update = () => {
    frame = 0;
    const threshold = window.innerHeight / 3;
    let active = sections[0];
    if (window.scrollY > 0) {
      for (const section of sections) {
        const { top, bottom } = section.getBoundingClientRect();
        // A short last section never reaches the top third, so it counts once it is fully in view.
        if (top <= threshold || (section === last && bottom <= window.innerHeight)) active = section;
      }
    }
    for (const link of links) {
      const isActive = link.dataset.navLink === active?.id;
      link.toggleAttribute('data-active', isActive);
      if (isActive) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();
</script>
