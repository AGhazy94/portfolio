---
import Icon from './Icon.astro';
import { profile, ui } from '../data/profile';
import { markSvg } from '../lib/mark';
import { brand } from '../lib/tokens.mjs';

interface Props {
  contactHref?: string;
  // The page shows its own orange button in the first screen, so the pill starts outlined.
  primaryCta?: boolean;
}

const path = Astro.url.pathname;
const home = path === '/';
const { contactHref = home ? '#contact' : '/#contact', primaryCta = home } = Astro.props;
const contactLink = ui.nav.find(({ section }) => section === 'contact')!;
const pages = ui.nav.filter(({ section }) => section !== 'contact');
const logo = markSvg({ ink: brand.electric, className: 'h-5 w-auto shrink-0' });
const contactPill =
  'rounded-pill border border-loud bg-loud px-4 py-2 text-sm leading-none font-medium text-bg transition-[opacity,background-color,color] duration-200 group-hover:opacity-85 group-data-[cta-in-view]/header:bg-transparent group-data-[cta-in-view]/header:text-loud';
---

<header
  data-header
  data-cta-in-view={primaryCta ? '' : undefined}
  class="group/header sticky top-0 z-40 border-b border-hairline bg-header backdrop-blur-lg backdrop-saturate-180"
>
  <div class="gutter">
    <div class="mx-auto flex h-14 max-w-page items-center justify-between gap-4">
      <a
        href={home ? '#top' : '/'}
        class="-ml-2 flex min-h-11 items-center gap-2.5 px-2 font-display text-ui font-bold tracking-tight whitespace-nowrap text-fg"
      >
        <Fragment set:html={logo} />
        {profile.name}
      </a>

      <div class="flex items-center">
        <nav aria-label={ui.navLabel} class="max-sm:hidden">
          <ul class="flex items-center">
            {pages.map(({ label, href, section }) => (
              <li>
                <a
                  href={href}
                  data-nav-link={home ? section : undefined}
                  aria-current={!section && path.startsWith(href) ? 'page' : undefined}
                  class="relative flex min-h-11 items-center px-2.5 text-sm text-muted transition-colors duration-200 after:absolute after:inset-x-2.5 after:bottom-2.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-loud after:transition-transform after:duration-300 after:ease-out hover:text-fg hover:after:scale-x-100 aria-[current]:text-fg aria-[current]:after:scale-x-100 motion-reduce:after:transition-none"
                >
                  {label}
                </a>
              </li>
            ))}
            <li>
              <a
                href={contactHref}
                data-nav-link={home ? contactLink.section : undefined}
                class="group ml-2 -mr-1 flex min-h-11 items-center px-1"
              >
                <span class={contactPill}>{contactLink.label}</span>
              </a>
            </li>
          </ul>
        </nav>

        <a href={contactHref} class="group flex min-h-11 items-center px-1 sm:hidden">
          <span class={contactPill}>{contactLink.label}</span>
        </a>

        <details data-mobile-menu class="group relative -mr-2 ml-1 sm:hidden">
          <summary class="grid size-11 cursor-pointer list-none place-items-center text-fg [&::-webkit-details-marker]:hidden">
            <span class="sr-only">{ui.menu}</span>
            <Icon name="menu" class="size-5 group-open:hidden" />
            <Icon name="close" class="hidden size-5 group-open:block" />
          </summary>
          <nav
            aria-label={ui.navLabel}
            class="absolute top-full right-0 mt-2 w-56 rounded-field border border-divider bg-surface p-2"
          >
            <ul>
              {ui.nav.map(({ label, href, section }) => (
                <li>
                  <a
                    href={section === 'contact' ? contactHref : href}
                    aria-current={!section && path.startsWith(href) ? 'page' : undefined}
                    class="flex min-h-11 items-center rounded-field px-4 text-ui text-body hover:bg-surface-2 hover:text-fg aria-[current]:bg-surface-2 aria-[current]:text-fg"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<script>
  // The site no longer has a light theme; this drops the choice older versions stored.
  try {
    localStorage.removeItem('theme');
  } catch {}

  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]')!;
  const menuToggle = menu.querySelector('summary')!;
  for (const link of menu.querySelectorAll('a')) {
    link.addEventListener('click', () => {
      menu.open = false;
    });
  }
  document.addEventListener('click', (event) => {
    if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.open) {
      event.preventDefault();
      menu.open = false;
      menuToggle.focus();
    }
  });
  matchMedia('(min-width: 640px)').addEventListener('change', ({ matches }) => {
    if (matches) menu.open = false;
  });

  // One orange button per screen: while the page's own one is visible, the Contact pill steps back to an outline.
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const visibleCtas = new Set<Element>();
  const ctaObserver = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        if (isIntersecting) visibleCtas.add(target);
        else visibleCtas.delete(target);
      }
      header.toggleAttribute('data-cta-in-view', visibleCtas.size > 0);
    },
    { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
  );
  const ctas = document.querySelectorAll('[data-primary-cta]');
  for (const cta of ctas) ctaObserver.observe(cta);
  if (!ctas.length) header.removeAttribute('data-cta-in-view');

  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.navLink!))
    .filter((section): section is HTMLElement => section !== null);
  const last = sections[sections.length - 1];

  let frame = 0;
  const update = () => {
    frame = 0;
    const threshold = window.innerHeight / 3;
    let active: HTMLElement | undefined;
    for (const section of sections) {
      const { top, bottom } = section.getBoundingClientRect();
      // A short last section never reaches the top third, so it counts once it is fully in view.
      if (top <= threshold || (section === last && bottom <= window.innerHeight)) active = section;
    }
    for (const link of links) {
      if (link.dataset.navLink === active?.id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();
</script>
