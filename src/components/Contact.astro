---
import Icon from './Icon.astro';
import RichText from './RichText.astro';
import { ui } from '../data/profile';
import { attributionFields } from '../lib/attribution';

const section = ui.sections.find(({ id }) => id === 'contact')!;
const { fields, errors, success } = ui.contact;
const [successBefore, successAfter] = success.body.split('{email}');

const inputs = [
  { name: 'name', type: 'text', autocomplete: 'name', ...fields.name },
  { name: 'email', type: 'email', autocomplete: 'email', ...fields.email },
] as const;

const fieldClass =
  'w-full rounded-field border border-field-border bg-field px-4 py-3 text-base text-fg placeholder:text-muted aria-invalid:border-error read-only:opacity-70';
const buttonClass =
  'inline-flex min-h-12 cursor-pointer items-center justify-center rounded-pill bg-fg px-6.5 text-[15px] font-medium text-surface transition-[opacity,scale] duration-200 hover:opacity-85 motion-safe:active:scale-[0.97] disabled:cursor-wait disabled:opacity-60';
---

<section
  id={section.id}
  aria-labelledby="contact-title"
  class="gutter border-t border-divider bg-surface py-16 md:py-20"
>
  <div class="mx-auto max-w-page text-center">
    <h2 id="contact-title" class="type-contact text-fg">
      {section.title}
    </h2>
    <RichText
      source={ui.contact.intro}
      class="mx-auto mt-5 max-w-[42ch] text-[17px] leading-normal text-balance text-body *:wrap-anywhere"
    />

    <form
      name="contact"
      method="POST"
      action="/thanks/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-contact-form
      data-errors={JSON.stringify(errors)}
      data-sending={ui.contact.sending}
      class="mx-auto mt-10 grid max-w-[560px] gap-x-3 gap-y-4 text-left sm:grid-cols-2"
    >
      <input type="hidden" name="form-name" value="contact" />
      <input type="hidden" name="subject" data-remove-prefix value={ui.contact.subject} />
      {/* Netlify stores it with each message, so every lead shows the page that brought it. */}
      <input type="hidden" name="page" value={Astro.url.pathname} />
      {/* Filled at submit with how the visitor first arrived; empty without JavaScript. */}
      {attributionFields.map(([name]) => (
        <input type="hidden" name={name} value="" />
      ))}
      <p class="hidden">
        <label>
          {ui.contact.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      {inputs.map((input) => (
        <div class="grid content-start gap-2">
          <label for={`contact-${input.name}`} class="text-[13px] font-medium text-body">
            {input.label}
          </label>
          <input
            id={`contact-${input.name}`}
            name={input.name}
            type={input.type}
            autocomplete={input.autocomplete}
            placeholder={input.placeholder}
            required
            maxlength="200"
            aria-describedby={`contact-${input.name}-error`}
            data-field
            class={fieldClass}
          />
          <p id={`contact-${input.name}-error`} hidden class="flex items-start gap-1.5 text-[13px] text-error">
            <Icon name="error" class="mt-0.5 size-3.5 shrink-0" />
            <span data-error-text />
          </p>
        </div>
      ))}

      {ui.contact.choices.map((choice, index) => (
        <div class:list={['grid content-start gap-2', index === 0 && 'sm:col-span-2']}>
          <label for={`contact-${choice.name}`} class="text-[13px] font-medium text-body">
            {choice.label}
            <span class="ml-1 font-normal text-muted">({ui.contact.optional})</span>
          </label>
          <div class="relative">
            <select
              id={`contact-${choice.name}`}
              name={choice.name}
              class={`${fieldClass} cursor-pointer appearance-none truncate pr-11`}
            >
              <option value="">{choice.placeholder}</option>
              {choice.options.map((option) => (
                <option value={option}>{option}</option>
              ))}
            </select>
            {/* The native arrow sits on the border, so the select is drawn flat and the arrow gets its own inset. */}
            <Icon
              name="chevron"
              class="pointer-events-none absolute top-1/2 right-3.5 size-5 -translate-y-1/2 text-muted"
            />
          </div>
        </div>
      ))}

      <div class="grid gap-2 sm:col-span-2">
        <label for="contact-message" class="text-[13px] font-medium text-body">
          {fields.message.label}
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          placeholder={fields.message.placeholder}
          required
          minlength="10"
          maxlength="5000"
          aria-describedby="contact-message-error"
          data-field
          class:list={[fieldClass, 'resize-y leading-normal']}
        ></textarea>
        <p id="contact-message-error" hidden class="flex items-start gap-1.5 text-[13px] text-error">
          <Icon name="error" class="mt-0.5 size-3.5 shrink-0" />
          <span data-error-text />
        </p>
      </div>

      <div role="alert" data-form-alert class="text-[15px] leading-normal text-body empty:hidden sm:col-span-2"></div>
      <template data-form-failure>
        <div class="flex items-start gap-2">
          <Icon name="error" class="mt-1 size-4 shrink-0 text-error" />
          <RichText source={ui.contact.failure} />
        </div>
      </template>

      <div class="mt-2 text-center sm:col-span-2">
        <button type="submit" class={buttonClass}>
          {ui.contact.submit}
        </button>
        <RichText source={ui.contact.privacy} class="mx-auto mt-4 max-w-[46ch] text-[13px] leading-normal text-muted" />
      </div>
    </form>

    <div data-contact-success role="status" hidden class="mx-auto mt-10 max-w-[560px]">
      <Icon name="check" class="mx-auto size-8 text-success" />
      <h3 tabindex="-1" class="type-project mt-4 text-fg focus:outline-none">
        {success.title}
      </h3>
      <p class="mt-3 text-[17px] leading-normal text-body">
        {successBefore}
        <span data-success-email class="font-medium wrap-anywhere text-fg"></span>
        {successAfter}
      </p>
      <button type="button" data-contact-reset class:list={[buttonClass, 'mt-8']}>
        {success.again}
      </button>
    </div>
  </div>
</section>

<script>
  import { attributionFields, firstTouch } from '../lib/attribution';
  import { trackLead } from '../lib/analytics';

  type Field = HTMLInputElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const errors: Record<string, string> = JSON.parse(form.dataset.errors!);
    const fields = [...form.querySelectorAll<Field>('[data-field]')];
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.textContent!.trim();
    const alert = form.querySelector<HTMLElement>('[data-form-alert]')!;
    const failure = form.querySelector<HTMLTemplateElement>('[data-form-failure]')!;
    const success = document.querySelector<HTMLElement>('[data-contact-success]')!;

    // Inline errors replace the browser's bubbles; the constraints stay as the no-JS fallback.
    form.noValidate = true;

    const messageFor = (field: Field) => {
      if (!field.value.trim()) return errors[`${field.name}Required`];
      if (field.validity.typeMismatch) return errors.emailInvalid;
      if (field.validity.tooShort) return errors.messageShort;
      return '';
    };

    const check = (field: Field) => {
      const message = messageFor(field);
      const error = document.getElementById(`${field.id}-error`)!;
      error.querySelector('[data-error-text]')!.textContent = message;
      error.hidden = !message;
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
      return !message;
    };

    for (const field of fields) {
      field.addEventListener('blur', () => {
        if (field.value || field.hasAttribute('aria-invalid')) check(field);
      });
      field.addEventListener('input', () => {
        if (field.hasAttribute('aria-invalid')) check(field);
      });
    }

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      submit.textContent = busy ? form.dataset.sending! : submitLabel;
      form.setAttribute('aria-busy', String(busy));
      for (const field of fields) field.readOnly = busy;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      alert.replaceChildren();
      const invalid = fields.filter((field) => !check(field));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      setBusy(true);
      const touch = firstTouch();
      for (const [name, key] of attributionFields) {
        (form.elements.namedItem(name) as HTMLInputElement).value = String(touch?.[key] ?? '');
      }
      try {
        const body = new URLSearchParams([...new FormData(form)] as [string, string][]).toString();
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
          signal: AbortSignal.timeout(15000),
        });
        if (!response.ok) throw new Error(`Form submission failed with ${response.status}`);
        trackLead();

        success.querySelector('[data-success-email]')!.textContent = String(new FormData(form).get('email'));
        form.hidden = true;
        success.hidden = false;
        success.querySelector<HTMLElement>('h3')!.focus();
      } catch {
        alert.replaceChildren(failure.content.cloneNode(true));
      } finally {
        setBusy(false);
      }
    });

    success.querySelector('[data-contact-reset]')!.addEventListener('click', () => {
      form.reset();
      for (const field of fields) {
        field.removeAttribute('aria-invalid');
        document.getElementById(`${field.id}-error`)!.hidden = true;
      }
      success.hidden = true;
      form.hidden = false;
      fields[0].focus();
    });
  }
</script>
