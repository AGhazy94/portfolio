---
import Icon from './Icon.astro';
import NextSteps from './NextSteps.astro';
import RichText from './RichText.astro';
import { useCopy } from '../i18n';
import { attributionFields } from '../lib/attribution';

const { ui, href, english } = await useCopy(Astro.currentLocale);

const section = ui.sections.find(({ id }) => id === 'contact')!;
const { fields, errors, success, tool } = ui.contact;
const [successBefore, successAfter] = success.body.split('{email}');

const inputs = [
  { name: 'name', type: 'text', autocomplete: 'name', ...fields.name },
  { name: 'email', type: 'email', autocomplete: 'email', ...fields.email },
] as const;

const fieldClass =
  'w-full rounded-field border border-field-border bg-field px-4 py-3 text-base text-fg placeholder:text-muted aria-invalid:border-error';
// Every select matches :read-only, so only the fields setBusy() locks get dimmed.
const typedClass = `${fieldClass} read-only:opacity-70`;
const buttonClass = 'btn-pill min-h-12 cursor-pointer bg-loud text-bg disabled:cursor-wait disabled:opacity-60';
---

<section id={section.id} aria-labelledby="contact-title" class="gutter band-section py-20 md:py-28">
  <div class="mx-auto grid max-w-page gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-start lg:gap-14">
    <div class="max-w-[30rem]">
      <h2 id="contact-title" class="type-section text-fg">
        {section.title}
      </h2>
      <RichText
        source={ui.contact.intro}
        class="mt-5 max-w-[42ch] text-reading leading-normal text-pretty text-body *:wrap-break-word"
      />
      <NextSteps class="mt-10" />
    </div>

    <div class="rounded-panel border border-divider bg-surface-2 p-[clamp(20px,4cqi,36px)] lg:max-w-[600px]">
      <form
        name="contact"
        method="POST"
        action={href('/thanks/')}
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-contact-form
        data-errors={JSON.stringify(errors)}
        data-sending={ui.contact.sending}
        data-success={success.body}
        data-failure={ui.contact.failure}
        toolname={tool.name}
        tooldescription={tool.description}
        class="grid gap-x-3 gap-y-4 sm:grid-cols-2"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="subject" data-remove-prefix value={ui.contact.subject} />
        {/* Netlify stores it with each message, so every lead shows the page that brought it. */}
        <input type="hidden" name="page" value={Astro.url.pathname} />
        {/* Filled at submit with how the visitor first arrived; empty without JavaScript. */}
        {attributionFields.map(([name]) => (
          <input type="hidden" name={name} value="" />
        ))}
        <p class="hidden">
          <label>
            {ui.contact.honeypot}{' '}
            <input name="bot-field" tabindex="-1" autocomplete="off" toolparamdescription={tool.params['bot-field']} />
          </label>
        </p>

        {inputs.map((input) => (
          <div class="grid content-start gap-2">
            <label for={`contact-${input.name}`} class="text-caption font-medium text-body">
              {input.label}
            </label>
            <input
              id={`contact-${input.name}`}
              name={input.name}
              type={input.type}
              autocomplete={input.autocomplete}
              dir={input.name === 'email' ? 'ltr' : undefined}
              placeholder={input.placeholder}
              required
              maxlength="200"
              aria-describedby={`contact-${input.name}-error`}
              toolparamdescription={tool.params[input.name]}
              data-field
              class={typedClass}
            />
            <p id={`contact-${input.name}-error`} hidden class="flex items-start gap-1.5 text-caption text-error">
              <Icon name="error" class="mt-0.5 size-3.5 shrink-0" />
              <span data-error-text />
            </p>
          </div>
        ))}

        {ui.contact.choices.map((choice, index) => (
          <div class:list={['grid content-start gap-2', index === 0 && 'sm:col-span-2']}>
            <label for={`contact-${choice.name}`} class="text-caption font-medium text-body">
              {choice.label}
              <span class="ms-1 font-normal text-muted">({ui.contact.optional})</span>
            </label>
            <div class="relative">
              <select
                id={`contact-${choice.name}`}
                name={choice.name}
                toolparamdescription={choice.tool}
                class={`${fieldClass} cursor-pointer appearance-none truncate pe-11`}
              >
                <option value="">{choice.placeholder}</option>
                {/* Netlify stores the value, so every language submits the English one and lists stay comparable. */}
                {choice.options.map((option, optionIndex) => (
                  <option value={english.ui.contact.choices[index]!.options[optionIndex]}>{option}</option>
                ))}
              </select>
              {/* The native arrow sits on the border, so the select is drawn flat and the arrow gets its own inset. */}
              <Icon
                name="chevron"
                class="pointer-events-none absolute end-3.5 top-1/2 size-5 -translate-y-1/2 text-muted"
              />
            </div>
          </div>
        ))}

        <div class="grid gap-2 sm:col-span-2">
          <label for="contact-message" class="text-caption font-medium text-body">
            {fields.message.label}
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            placeholder={fields.message.placeholder}
            required
            minlength="10"
            maxlength="5000"
            aria-describedby="contact-message-error"
            toolparamdescription={tool.params.message}
            data-field
            class:list={[typedClass, 'resize-y leading-normal']}
          ></textarea>
          <p id="contact-message-error" hidden class="flex items-start gap-1.5 text-caption text-error">
            <Icon name="error" class="mt-0.5 size-3.5 shrink-0" />
            <span data-error-text />
          </p>
        </div>

        <div role="alert" data-form-alert class="text-ui leading-normal text-body empty:hidden sm:col-span-2"></div>
        <template data-form-failure>
          <div class="flex items-start gap-2">
            <Icon name="error" class="mt-1 size-4 shrink-0 text-error" />
            <RichText source={ui.contact.failure} />
          </div>
        </template>

        <div class="mt-2 sm:col-span-2">
          <button type="submit" data-primary-cta class:list={[buttonClass, 'w-full sm:w-auto']}>
            {ui.contact.submit}
          </button>
          <RichText
            source={ui.contact.privacy}
            class="mt-4 max-w-[46ch] text-caption leading-normal text-balance text-muted *:whitespace-nowrap"
          />
        </div>
      </form>

      {/* Empty until Netlify accepts a message, so pages never ship the reply line without an address. */}
      <div data-contact-success role="status"></div>
      <template data-contact-success-view>
        <Icon name="check" class="size-8 text-success" />
        {/* Focus scrolls to this heading; the margin keeps the check icon above it clear of the sticky header. */}
        <h3 tabindex="-1" class="type-project mt-4 scroll-mt-12 text-fg focus:outline-none">
          {success.title}
        </h3>
        <p class="mt-3 text-reading leading-normal text-body">
          {successBefore}
          <span data-success-email class="font-medium wrap-anywhere text-fg"></span>
          {successAfter}
        </p>
        <button type="button" data-contact-reset class:list={[buttonClass, 'mt-8']}>
          {success.again}
        </button>
      </template>
    </div>
  </div>
</section>

<script>
  import { attributionFields, firstTouch } from '../lib/attribution';
  import { trackLead } from '../lib/analytics';

  type Field = HTMLInputElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const errors: Record<string, string> = JSON.parse(form.dataset.errors!);
    const fields = [...form.querySelectorAll<Field>('[data-field]')];
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.textContent!.trim();
    const alert = form.querySelector<HTMLElement>('[data-form-alert]')!;
    const failure = form.querySelector<HTMLTemplateElement>('[data-form-failure]')!;
    const success = document.querySelector<HTMLElement>('[data-contact-success]')!;
    const successView = document.querySelector<HTMLTemplateElement>('[data-contact-success-view]')!;

    // Inline errors replace the browser's bubbles; the constraints stay as the no-JS fallback.
    form.noValidate = true;

    const messageFor = (field: Field) => {
      if (!field.value.trim()) return errors[`${field.name}Required`];
      if (field.validity.typeMismatch) return errors.emailInvalid;
      if (field.validity.tooShort) return errors.messageShort;
      return '';
    };

    const check = (field: Field) => {
      const message = messageFor(field);
      const error = document.getElementById(`${field.id}-error`)!;
      error.querySelector('[data-error-text]')!.textContent = message;
      error.hidden = !message;
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
      return !message;
    };

    for (const field of fields) {
      field.addEventListener('blur', () => {
        if (field.value || field.hasAttribute('aria-invalid')) check(field);
      });
      field.addEventListener('input', () => {
        if (field.hasAttribute('aria-invalid')) check(field);
      });
    }

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      submit.textContent = busy ? form.dataset.sending! : submitLabel;
      form.setAttribute('aria-busy', String(busy));
      for (const field of fields) field.readOnly = busy;
    };

    const reset = () => {
      form.reset();
      for (const field of fields) {
        field.removeAttribute('aria-invalid');
        document.getElementById(`${field.id}-error`)!.hidden = true;
      }
      success.replaceChildren();
      form.hidden = false;
      fields[0].focus();
    };

    const showSuccess = (email: string) => {
      const view = successView.content.cloneNode(true) as DocumentFragment;
      view.querySelector('[data-success-email]')!.textContent = email;
      view.querySelector('[data-contact-reset]')!.addEventListener('click', reset);
      form.hidden = true;
      success.replaceChildren(view);
      success.querySelector<HTMLElement>('h3')!.focus();
    };

    // WebMCP additions to SubmitEvent; not in the DOM typings yet.
    type AgentSubmitEvent = SubmitEvent & {
      agentInvoked?: boolean;
      respondWith?: (result: Promise<string>) => void;
    };

    form.addEventListener('submit', (event: AgentSubmitEvent) => {
      event.preventDefault();
      const result = send();
      if (event.agentInvoked) event.respondWith?.(result);
    });

    // Resolves to the outcome in words, which is what a browser agent gets back as the tool result.
    const send = async () => {
      alert.replaceChildren();
      const invalid = fields.filter((field) => !check(field));
      if (invalid.length) {
        invalid[0].focus();
        return invalid.map(messageFor).join(' ');
      }

      setBusy(true);
      const touch = firstTouch();
      for (const [name, key] of attributionFields) {
        (form.elements.namedItem(name) as HTMLInputElement).value = String(touch?.[key] ?? '');
      }
      try {
        const body = new URLSearchParams([...new FormData(form)] as [string, string][]).toString();
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
          signal: AbortSignal.timeout(15000),
        });
        if (!response.ok) throw new Error(`Form submission failed with ${response.status}`);
        trackLead();

        const email = String(new FormData(form).get('email'));
        showSuccess(email);
        return form.dataset.success!.replace('{email}', email);
      } catch {
        alert.replaceChildren(failure.content.cloneNode(true));
        return form.dataset.failure!;
      } finally {
        setBusy(false);
        // Disabling the button dropped focus; the success view moves it on its own.
        if (!form.hidden) submit.focus();
      }
    };
  }
</script>
