---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile, socials, ui } from '../data/profile';

const profiles = socials.filter(({ href }) => !href.startsWith('mailto:'));
---

<section id="top" aria-labelledby="hero-title" class="gutter py-12 md:py-16">
  <div class="relative mx-auto max-w-page">
    {/* Kept out of the h1 so the alt text doesn't join the heading's name; it sits in the eyebrow row visually. */}
    <Image
      src={profile.portrait}
      alt={ui.hero.portraitAlt}
      width={40}
      height={40}
      densities={[1, 2]}
      loading="eager"
      class="absolute top-0 left-0 size-10 rounded-full bg-surface object-cover"
    />

    <h1 id="hero-title">
      <span class="flex min-h-10 items-center pl-13 text-ui">
        <span>
          <span class="font-medium text-fg">{profile.name}</span>
          <span class="sr-only">, </span>
          {/* The dot is drawn, not typed, so crawlers read "name, role" without a stray "·". */}
          <span class="whitespace-nowrap text-muted before:mx-2 before:inline-block before:size-[3px] before:rounded-full before:bg-current before:align-middle before:content-['']">
            {ui.hero.role}
          </span>
        </span>
      </span>
      <span class="sr-only">, </span>
      <span class="type-hero mt-5 block max-w-[17ch] text-fg">{profile.offer}</span>
    </h1>
    <p class="type-lead mt-5 max-w-[46ch] text-pretty text-body">{profile.offerLead}</p>

    <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="#contact" class="btn-pill min-h-12 bg-fg text-bg">
        {ui.hero.contact}
      </a>
      <a
        href="#projects"
        class="inline-flex min-h-11 items-center gap-1 text-ui font-medium text-accent hover:underline underline-offset-4"
      >
        {ui.hero.work}
        <Icon name="chevron" class="size-5 -rotate-90" />
      </a>
    </div>
    <p class="mt-3 text-caption text-muted">{ui.hero.availability}</p>
    <ul aria-label={ui.socialLabel} class="flex flex-wrap gap-x-4 text-caption text-muted">
      {profiles.map(({ label, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noreferrer noopener"
            class="inline-flex min-h-11 items-center underline decoration-1 underline-offset-3 transition-colors duration-200 hover:text-fg"
          >
            {label}
            <span class="sr-only">{ui.newTab}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
