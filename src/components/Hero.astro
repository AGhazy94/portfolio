---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile, socials, ui } from '../data/profile';

const profiles = socials.filter(({ href }) => !href.startsWith('mailto:'));
---

<section id="top" aria-labelledby="hero-title" class="gutter py-10 md:py-14">
  <div class="mx-auto flex max-w-page flex-col items-center text-center">
    <div class="size-16 overflow-hidden rounded-full bg-surface">
      <Image
        src={profile.portrait}
        alt={ui.hero.portraitAlt}
        width={64}
        height={64}
        densities={[1, 2]}
        loading="eager"
        data-portrait
        class="size-full object-cover"
      />
    </div>

    <h1 id="hero-title" class="mt-5">
      <span class="type-hero block text-fg">{profile.name}</span>
      <span class="sr-only">, </span>
      <span class="type-lead mx-auto mt-4 block max-w-[40ch] text-balance text-body">{profile.tagline}</span>
    </h1>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <a
        href="#contact"
        class="inline-flex min-h-11 items-center rounded-pill bg-fg px-6.5 text-[15px] font-medium text-bg transition-[opacity,scale] duration-200 hover:opacity-85 motion-safe:active:scale-[0.97]"
      >
        {ui.hero.contact}
      </a>
      <a
        href="#projects"
        class="inline-flex min-h-11 items-center gap-1 text-[15px] font-medium text-accent hover:underline underline-offset-4"
      >
        {ui.hero.work}
        <Icon name="chevron" class="size-5 -rotate-90" />
      </a>
    </div>
    <p class="mt-3 text-[13px] text-muted">{ui.hero.availability}</p>
    <ul aria-label={ui.socialLabel} class="mt-1 flex flex-wrap justify-center gap-x-4 text-[13px] text-muted">
      {profiles.map(({ label, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noreferrer noopener"
            class="inline-flex min-h-6 items-center underline decoration-1 underline-offset-3 transition-colors duration-200 hover:text-fg"
          >
            {label}
            <span class="sr-only">{ui.newTab}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { withMotion } from '../lib/with-motion';

  withMotion(({ gsap }) => {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap.fromTo(
        '[data-portrait]',
        { scale: 1.12 },
        {
          scale: 1,
          ease: 'none',
          // A short scrub lag eases the portrait into place when GSAP arrives after the first paint.
          scrollTrigger: { trigger: '[data-portrait]', start: 'top bottom', end: 'bottom top', scrub: 0.5 },
        },
      );
    });
  });
</script>
