---
import RichText from './RichText.astro';
import { ui } from '../data/profile';

// Set for production only (netlify.toml), so previews and local builds never report to Google.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const buttonClass =
  'inline-flex min-h-11 flex-1 cursor-pointer items-center justify-center rounded-pill px-5 text-[14px] font-medium transition-[opacity,scale] duration-200 hover:opacity-85 motion-safe:active:scale-[0.97] sm:flex-none';
---

<div
  data-consent
  data-measurement-id={measurementId}
  data-debug={import.meta.env.DEV ? '' : undefined}
  role="region"
  aria-label={ui.consent.label}
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-divider bg-surface"
>
  <div class="gutter mx-auto flex max-w-page flex-col gap-3 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-4">
    <div class="min-w-0">
      <p class="text-[14px] font-semibold text-fg">{ui.consent.title}</p>
      <RichText source={ui.consent.body} class="mt-0.5 text-[13px] leading-snug text-body" />
    </div>
    <div class="flex shrink-0 gap-2">
      <button type="button" data-consent-choice="granted" class:list={[buttonClass, 'bg-fg text-surface']}>
        {ui.consent.allow}
      </button>
      <button
        type="button"
        data-consent-choice="denied"
        class:list={[buttonClass, 'border border-field-border bg-transparent text-fg']}
      >
        {ui.consent.decline}
      </button>
    </div>
  </div>
</div>

<script>
  import { CONSENT_KEY, forgetCachedConsent, getConsent, setConsent, type Consent } from '../lib/consent';
  import { forgetEntry, rememberEntry } from '../lib/attribution';
  import { clearAnalyticsCookies, loadAnalytics } from '../lib/analytics';

  const banner = document.querySelector<HTMLElement>('[data-consent]')!;
  const { measurementId, debug } = banner.dataset;

  const apply = () => {
    if (getConsent() !== 'granted') return;
    rememberEntry();
    if (measurementId) loadAnalytics(measurementId, debug !== undefined);
  };

  apply();
  banner.hidden = getConsent() !== null;

  for (const button of banner.querySelectorAll<HTMLButtonElement>('[data-consent-choice]')) {
    button.addEventListener('click', () => {
      const choice = button.dataset.consentChoice as Consent;
      const withdrawn = getConsent() === 'granted' && choice === 'denied';
      setConsent(choice);
      banner.hidden = true;
      if (choice === 'granted') return apply();
      forgetEntry();
      clearAnalyticsCookies();
      // A loaded gtag.js keeps sending until the page goes away.
      if (withdrawn) location.reload();
    });
  }

  // A choice made in another tab applies here too; a loaded gtag.js only stops when the page goes away.
  window.addEventListener('storage', (event) => {
    if (event.key !== CONSENT_KEY && event.key !== null) return;
    forgetCachedConsent();
    banner.hidden = getConsent() !== null;
    if (getConsent() === 'granted') apply();
    else if (window.gtag) location.reload();
  });

  for (const opener of document.querySelectorAll('[data-consent-open]')) {
    opener.addEventListener('click', () => {
      banner.hidden = false;
      banner.querySelector('button')!.focus();
    });
  }
</script>
