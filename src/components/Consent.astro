---
import RichText from './RichText.astro';
import { ui } from '../data/profile';

// Set for production only (netlify.toml), so previews and local builds never report to Google or Ahrefs.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const ahrefsKey = import.meta.env.PUBLIC_AHREFS_ANALYTICS_KEY;
const buttonClass =
  'inline-flex min-h-11 flex-1 cursor-pointer items-center justify-center rounded-pill px-5 text-sm font-medium transition-[opacity,scale] duration-200 hover:opacity-85 motion-safe:active:scale-[0.97] sm:flex-none';
---

<div
  data-consent
  data-measurement-id={measurementId}
  data-ahrefs-key={ahrefsKey}
  data-debug={import.meta.env.DEV ? '' : undefined}
  role="region"
  aria-label={ui.consent.label}
  hidden
  class="fixed inset-x-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 mx-auto max-w-[600px] rounded-field border border-field-border bg-surface-2"
>
  <div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-fg">{ui.consent.title}</p>
      <RichText source={ui.consent.body} class="mt-0.5 text-caption leading-snug text-body" />
    </div>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-consent-choice="denied"
        class:list={[buttonClass, 'border border-field-border bg-transparent text-fg']}
      >
        {ui.consent.decline}
      </button>
      <button
        type="button"
        data-consent-choice="granted"
        class:list={[buttonClass, 'border border-field-border bg-transparent text-fg']}
      >
        {ui.consent.allow}
      </button>
    </div>
  </div>
</div>

<script>
  import { CONSENT_KEY, forgetCachedConsent, getConsent, setConsent, type Consent } from '../lib/consent';
  import { forgetEntry, rememberEntry } from '../lib/attribution';
  import { clearAnalyticsCookies, loadAhrefs, loadAnalytics } from '../lib/analytics';

  const banner = document.querySelector<HTMLElement>('[data-consent]')!;
  const { measurementId, ahrefsKey, debug } = banner.dataset;

  if (ahrefsKey) loadAhrefs(ahrefsKey);

  const apply = () => {
    if (getConsent() !== 'granted') return;
    rememberEntry();
    if (measurementId) loadAnalytics(measurementId, debug !== undefined);
  };

  apply();
  banner.hidden = getConsent() !== null;

  // Consent that expired or was withdrawn in another tab leaves _ga cookies and the first-touch record behind.
  if (getConsent() !== 'granted') {
    try {
      clearAnalyticsCookies();
      forgetEntry();
    } catch {}
  }

  let opener: HTMLElement | null = null;

  for (const button of banner.querySelectorAll<HTMLButtonElement>('[data-consent-choice]')) {
    button.addEventListener('click', () => {
      const choice = button.dataset.consentChoice as Consent;
      const withdrawn = getConsent() === 'granted' && choice === 'denied';
      setConsent(choice);
      banner.hidden = true;
      // Hiding the focused banner would send the next Tab back to the top of the page.
      opener?.focus();
      opener = null;
      if (choice === 'granted') return apply();
      forgetEntry();
      clearAnalyticsCookies();
      // A loaded gtag.js keeps sending until the page goes away.
      if (withdrawn) location.reload();
    });
  }

  // A choice made in another tab applies here too; a loaded gtag.js only stops when the page goes away.
  window.addEventListener('storage', (event) => {
    if (event.key !== CONSENT_KEY && event.key !== null) return;
    forgetCachedConsent();
    banner.hidden = getConsent() !== null;
    if (getConsent() === 'granted') apply();
    else if (window.gtag) location.reload();
  });

  for (const control of document.querySelectorAll<HTMLElement>('[data-consent-open]')) {
    control.addEventListener('click', () => {
      opener = control;
      banner.hidden = false;
      banner.querySelector('button')!.focus();
    });
  }
</script>
