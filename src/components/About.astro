---
import RichText from './RichText.astro';
import { useCopy } from '../i18n';

const { about, profile, statement, ui } = await useCopy(Astro.currentLocale);

const section = ui.sections.find(({ id }) => id === 'about')!;
const words = statement.split(' ');
const languages = profile.languages.map(({ name, level }) => `${name} (${level})`).join(ui.about.separator);
---

<section id={section.id} aria-labelledby="about-title" class="gutter border-t border-divider py-20 md:py-28">
  <div class="mx-auto max-w-page">
    <h2 id="about-title" class="type-section text-fg">
      {section.title}
    </h2>

    <p data-statement class="type-statement mt-8 max-w-[28ch] text-fg">
      {words.map((word, index) => [<span data-word>{word}</span>, index < words.length - 1 ? ' ' : ''])}
    </p>

    <div class="mt-8 grid gap-y-8 border-t border-divider pt-8 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <dl class="space-y-5 text-ui">
        <div>
          <dt class="text-caption text-muted">{ui.about.education}</dt>
          <dd class="mt-1 leading-normal text-fg">
            {`${profile.education.degree}${ui.about.separator}`}
            <bdi dir="ltr" class="whitespace-nowrap">
              {profile.education.years}
            </bdi>
          </dd>
        </div>
        <div>
          <dt class="text-caption text-muted">{ui.about.languages}</dt>
          <dd class="mt-1 leading-normal text-fg">{languages}</dd>
        </div>
      </dl>

      <div class="max-w-[62ch] space-y-5 text-reading leading-[1.6] text-body">
        {about.map((paragraph) => (
          <RichText source={paragraph} />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { withMotion } from '../lib/with-motion';

  withMotion(({ gsap, ScrollTrigger }) => {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', (context) => {
      // Words dim only just before they scroll in, so text nobody has reached yet stays at full contrast.
      ScrollTrigger.create({
        trigger: '[data-statement]',
        start: 'top bottom+=200',
        once: true,
        onEnter: () =>
          context.add(() => {
            // The words start at 0.2, not the design's 0.14, so the line never reads as missing text.
            gsap.fromTo(
              '[data-word]',
              { opacity: 0.2 },
              {
                opacity: 1,
                duration: 0.6,
                ease: 'power1.out',
                stagger: 0.07,
                scrollTrigger: { trigger: '[data-statement]', start: 'top 80%', once: true },
              },
            );
          }),
      });
    });
  });
</script>
