---
import { useCopy } from '../i18n';

const { profile, testimonials, ui, locale, langOf } = await useCopy(Astro.currentLocale);

const section = ui.sections.find(({ id }) => id === 'testimonials')!;
const sources = {
  LinkedIn: `${profile.linkedin}/details/recommendations/`,
  Upwork: profile.upwork,
};
---

<section id={section.id} aria-labelledby="testimonials-title" class="gutter border-t border-divider py-20 md:py-28">
  <div class="mx-auto max-w-page">
    <h2 id="testimonials-title" class="type-section text-fg">
      {section.title}
    </h2>
    {locale !== 'en' && <p class="mt-3 text-caption text-muted">{ui.testimonials.original}</p>}

    <ul class="mt-10 grid gap-[clamp(14px,3cqi,28px)] md:grid-cols-2">
      {testimonials.map((item) => (
        <li class="flex">
          <figure class="flex w-full flex-col rounded-card border border-divider bg-surface p-[clamp(24px,3.5cqi,32px)]">
            {/* Follows the English quote's direction, so the mark sits on the edge the quote starts from. */}
            <span aria-hidden="true" {...langOf('en')} class="font-accent text-6xl leading-[0.6] text-brand italic">
              “
            </span>
            <blockquote {...langOf('en')} class="mt-3 text-base leading-[1.6] text-fg md:text-reading">
              <p>{item.quote}</p>
            </blockquote>
            <figcaption class="mt-auto pt-6 text-caption leading-[1.6] text-pretty text-muted">
              <span class="block font-medium text-body">{item.name}</span>
              {/* The dot ends the line before, so a wrap never opens a line with it. */}
              {item.context}&nbsp;·{' '}
              <span class="whitespace-nowrap">
                {ui.testimonials.via}{' '}
                <a
                  href={sources[item.source]}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="underline decoration-1 underline-offset-3 transition-colors duration-200 hover:text-fg"
                >
                  {item.source}
                  <span class="sr-only">{ui.newTab}</span>
                </a>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
