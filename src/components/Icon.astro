---
import remix from '@iconify-json/ri/icons.json';
// Client logos from their own sites, reduced to one colour (currentColor) in the Iconify set format.
import logos from '../assets/logos.json';

const sets = {
  contrast: { set: remix, name: 'contrast-fill' },
  check: { set: remix, name: 'checkbox-circle-fill' },
  error: { set: remix, name: 'error-warning-fill' },
  close: { set: remix, name: 'close-line' },
  scriptbee: { set: logos, name: 'scriptbee' },
  leicht: { set: logos, name: 'leicht' },
} as const;

type IconName = keyof typeof sets;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const { set, name: key } = sets[name];
const icon = (set.icons as Record<string, { body: string; width?: number; height?: number }>)[key];
const defaults = set as { width?: number; height?: number };
const width = icon.width ?? defaults.width ?? 24;
const height = icon.height ?? defaults.height ?? 24;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>
