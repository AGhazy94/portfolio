---
import { parseInline } from '../lib/inline';
import { ui } from '../data/profile';

interface Props {
  source: string;
  class?: string;
  linkClass?: string;
}

const {
  source,
  class: className,
  linkClass = 'text-accent underline decoration-1 underline-offset-3 transition-opacity duration-200 hover:opacity-70',
} = Astro.props;
---

<p class={className}>
  {parseInline(source).map((segment) => {
    if (segment.kind === 'text') return segment.text;
    if (segment.kind === 'strong') return <strong class="font-semibold text-fg">{segment.text}</strong>;
    const external = /^https?:/.test(segment.href);
    return (
      <a
        class={linkClass}
        href={segment.href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noreferrer noopener' : undefined}
      >
        {segment.text}
        {external && <span class="sr-only">{ui.newTab}</span>}
      </a>
    );
  })}
</p>
