---
import { parseInline } from '../lib/inline';
import { ui } from '../data/profile';

interface Props {
  source: string;
  class?: string;
  linkClass?: string;
}

const {
  source,
  class: className,
  linkClass = 'font-medium text-slate-200 hover:text-teal-300 focus-visible:text-teal-300',
} = Astro.props;
---

<p class={className}>
  {parseInline(source).map((segment) => {
    if (segment.kind === 'text') return segment.text;
    if (segment.kind === 'strong') return <span class="text-slate-200">{segment.text}</span>;
    const external = /^https?:/.test(segment.href);
    return (
      <a
        class={linkClass}
        href={segment.href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noreferrer noopener' : undefined}
      >
        {segment.text}
        {external && <span class="sr-only">{ui.newTab}</span>}
      </a>
    );
  })}
</p>
