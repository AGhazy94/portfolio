---
import RichText from './RichText.astro';
import { profile, socials, ui } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="gutter border-t border-divider">
  <div class="mx-auto flex max-w-page flex-col gap-6 py-10 text-[13px] leading-[1.6] text-muted md:flex-row md:items-start md:justify-between">
    <div class="max-w-[62ch] space-y-2">
      <p>{`© ${year} ${profile.name} · ${ui.footer.place}`}</p>
      <RichText
        source={ui.footer.credit}
        linkClass="underline decoration-1 underline-offset-3 transition-colors duration-200 hover:text-fg"
      />
    </div>

    <ul aria-label={ui.socialLabel} class="-mx-2 flex shrink-0 flex-wrap items-center md:-mt-3">
      {socials.map(({ label, href }) => {
        const external = href.startsWith('http');
        return (
          <li>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noreferrer noopener' : undefined}
              class="flex min-h-11 items-center px-2 transition-colors duration-200 hover:text-fg"
            >
              {label}
              {external && <span class="sr-only">{ui.newTab}</span>}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</footer>
