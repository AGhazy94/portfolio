---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { title: string; summary: string; href: string; meta?: string; cta: string; image?: ImageMetadata }[];
  columns?: 2 | 3;
  // The first card spans two columns, so 3 cards in 2 columns or 5 in 3 leave no empty cell.
  featured?: boolean;
  headingLevel?: 2 | 3;
  class?: string;
}

const { items, columns = 2, featured = false, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}` as const;

// Card widths inside the 1080px page: 526px in 2 columns, 341px in 3; below 1024px a featured card fills the row.
const sizes = (lead: boolean) => {
  if (!lead) return `(min-width: 1024px) ${columns === 3 ? 341 : 526}px, (min-width: 768px) 50vw, 100vw`;
  return `(min-width: 1024px) ${columns === 3 ? 710 : 566}px, 100vw`;
};
const firstRow = featured ? (columns === 3 ? 2 : 1) : columns;
// The lead card splits image and text only in 2 columns from 1024px; narrower, the text outgrows the 16:9 art and crops it.
const split = columns === 2;
---

<ul
  class:list={[
    'grid gap-[clamp(14px,3cqi,28px)]',
    columns === 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2',
    className,
  ]}
>
  {items.map((item, index) => {
    const lead = featured && index === 0;
    return (
      <li
        class:list={[
          'group relative flex flex-col rounded-card bg-surface transition-transform duration-300 motion-safe:hover:-translate-y-1',
          lead && 'md:col-span-2',
          lead && split && 'lg:grid lg:grid-cols-[1.1fr_1fr]',
        ]}
      >
        {item.image && (
          <Image
            src={item.image}
            alt=""
            widths={[360, 540, 720, 1080]}
            sizes={sizes(lead)}
            loading={index < firstRow ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            data-art
            class:list={[
              'aspect-video w-full rounded-t-card object-cover',
              lead && (split ? 'lg:aspect-auto lg:h-full lg:rounded-tr-none lg:rounded-bl-card' : 'lg:aspect-[2/1]'),
            ]}
          />
        )}
        <div class:list={['flex flex-1 flex-col p-[clamp(20px,3cqi,28px)]', lead && split && 'lg:justify-center']}>
          {item.meta && (
            <p class="text-caption text-pretty text-muted">
              {item.meta.split(' · ').map((part, index) =>
                index ? (
                  <Fragment>
                    {' '}
                    <span class="whitespace-nowrap">· {part}</span>
                  </Fragment>
                ) : (
                  part
                ),
              )}
            </p>
          )}
          <Heading class:list={['type-project text-fg', item.meta && 'mt-1']}>
            <a href={item.href} class="card-link">
              {item.title}
            </a>
          </Heading>
          <p class="mt-3 text-base leading-[1.6] text-body md:text-ui">{item.summary}</p>
          <p
            aria-hidden="true"
            class:list={['mt-auto pt-6 text-ui font-medium text-accent', lead && split && 'lg:mt-0']}
          >
            {item.cta}{' '}
            <span class="inline-block transition-transform duration-200 motion-safe:group-hover:translate-x-[3px]">
              ›
            </span>
          </p>
        </div>
      </li>
    );
  })}
</ul>
