---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import MetaLine from './MetaLine.astro';

interface Props {
  items: { title: string; summary: string; href: string; meta?: string; cta: string; image?: ImageMetadata }[];
  columns?: 2 | 3;
  // The first card spans two columns, so 3 or 5 cards in 2 columns, or 5 in 3, leave no empty cell.
  featured?: boolean;
  headingLevel?: 2 | 3;
  class?: string;
}

const { items, columns = 2, featured = false, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}` as const;

// Card widths inside the 1080px page: 526px in 2 columns, 341px in 3; below 1024px a featured card fills the row.
const sizes = (wide: boolean) => {
  if (!wide) return `(min-width: 1024px) ${columns === 3 ? 341 : 526}px, (min-width: 768px) 50vw, 100vw`;
  return `(min-width: 1024px) ${columns === 3 ? 710 : 566}px, 100vw`;
};
const firstRow = featured ? (columns === 3 ? 2 : 1) : columns;
// A card left alone on the last row of 2 columns fills it like the lead, so the grid never ends on an empty cell.
const lastWide = columns === 2 && (items.length - (featured ? 1 : 0)) % 2 === 1;
---

<ul
  class:list={[
    'grid gap-[clamp(14px,3cqi,28px)]',
    columns === 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2',
    className,
  ]}
>
  {items.map((item, index) => {
    const wide = (featured && index === 0) || (lastWide && index === items.length - 1);
    // A wide card splits image and text only in 2 columns from 1024px; narrower, the text outgrows the 16:9 art and crops it.
    const split = wide && columns === 2 && Boolean(item.image);
    return (
      <li
        class:list={[
          'group relative flex flex-col rounded-card bg-surface transition-transform duration-300 motion-safe:hover:-translate-y-1',
          wide && 'md:col-span-2',
          split && 'lg:grid lg:grid-cols-[1.1fr_1fr]',
        ]}
      >
        {item.image && (
          <Image
            src={item.image}
            alt=""
            widths={[360, 540, 720, 1080]}
            sizes={sizes(wide)}
            loading={index < firstRow ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            data-art
            class:list={[
              'aspect-video w-full rounded-t-card object-cover',
              wide && (split ? 'lg:aspect-auto lg:h-full lg:rounded-tr-none lg:rounded-bl-card' : 'lg:aspect-[2/1]'),
            ]}
          />
        )}
        <div class:list={['flex flex-1 flex-col p-[clamp(20px,3cqi,28px)]', split && 'lg:justify-center']}>
          {item.meta && <MetaLine text={item.meta} />}
          <Heading class:list={['type-project text-balance text-fg', item.meta && 'mt-1']}>
            <a href={item.href} class="card-link">
              {item.title}
            </a>
          </Heading>
          <p class="mt-3 max-w-[62ch] text-base leading-[1.6] text-body md:text-ui">{item.summary}</p>
          <p aria-hidden="true" class:list={['mt-auto pt-6 text-ui font-medium text-accent', split && 'lg:mt-0']}>
            {item.cta}{' '}
            <span class="inline-block transition-transform duration-200 motion-safe:group-hover:translate-x-[3px]">
              ›
            </span>
          </p>
        </div>
      </li>
    );
  })}
</ul>
