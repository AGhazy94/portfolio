---
import { render } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import { contentImage, getPosts, getServices } from '../../lib/content';
import { useCopy } from '../../i18n';

// src/pages/ar/blog/[id].astro renders this page with an Arabic entry.
export async function getStaticPaths() {
  return (await getPosts()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: Awaited<ReturnType<typeof getPosts>>[number] };

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const { profile, ui, locale, href, langOf } = await useCopy(Astro.currentLocale);
const image = contentImage('blog', entry.id);

const url = new URL(Astro.url.pathname, Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const service = (await getServices(locale)).find(({ id }) => id === data.service.id);
if (!service) throw new Error(`Missing service for article ${entry.id}`);
const relatedArticles = (await getPosts(locale)).filter((post) =>
  data.relatedArticles.some((reference) => reference.id === post.id),
);
const nodes = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    mainEntityOfPage: url,
    url,
    headline: data.title,
    description: data.description,
    datePublished: data.published.toISOString(),
    dateModified: data.updated.toISOString(),
    author: { '@id': personId, name: profile.name, url: new URL('/', Astro.site).href },
    publisher: { '@id': personId },
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
  },
];
---

<ContentPage
  title={`${data.title} | ${profile.name}`}
  description={data.description}
  heading={data.title}
  type="article"
  nodes={nodes}
  crumbs={[{ label: ui.blog.indexTitle, href: href('/blog/') }, { label: data.title }]}
  published={data.published}
  updated={data.updated}
  faq={data.faq}
  image={image}
  imageAlt={data.imageAlt}
  headings={headings}
>
  <Content />
  <div slot="after" class="mt-12 grid gap-10 border-t border-divider pt-8 md:grid-cols-2">
    <section aria-labelledby="related-service-title">
      <h2 id="related-service-title" class="text-sm font-medium text-muted">
        {ui.page.relatedServices}
      </h2>
      <div {...langOf(service.locale)}>
        <h3 class="type-project mt-3 text-fg">
          <a href={href(`/services/${service.id}/`)} class="underline underline-offset-4 hover:text-accent">
            {service.data.cardTitle}
          </a>
        </h3>
        <p class="mt-3 text-ui leading-relaxed text-body">{service.data.cardSummary}</p>
      </div>
    </section>
    {relatedArticles.length > 0 && (
      <section aria-labelledby="related-articles-title">
        <h2 id="related-articles-title" class="text-sm font-medium text-muted">
          {ui.page.relatedArticles}
        </h2>
        <ul class="mt-3 space-y-4">
          {relatedArticles.map((article) => (
            <li {...langOf(article.locale)}>
              <a
                href={href(`/blog/${article.id}/`)}
                class="text-lg leading-snug text-fg underline underline-offset-4 hover:text-accent"
              >
                {article.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</ContentPage>
