---
import ContentPage from '../../layouts/ContentPage.astro';
import PageCards from '../../components/PageCards.astro';
import { contentImage, getPosts } from '../../lib/content';
import { useCopy } from '../../i18n';

const { profile, ui, locale, href, langOf, formatDate } = await useCopy(Astro.currentLocale);
const posts = await getPosts(locale);
const url = new URL(Astro.url.pathname, Astro.site).href;
const nodes = [
  {
    '@type': 'CollectionPage',
    '@id': url,
    url,
    name: ui.blog.indexTitle,
    description: ui.blog.indexDescription,
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    about: { '@id': new URL('/#person', Astro.site).href },
  },
];
---

<ContentPage
  title={`${ui.blog.metaTitle} | ${profile.name}`}
  description={ui.blog.indexDescription}
  heading={ui.blog.indexHeading}
  nodes={nodes}
  crumbs={[{ label: ui.blog.indexTitle }]}
>
  <p>{ui.blog.indexLead}</p>
  <PageCards
    slot="after"
    class="mt-10"
    columns={3}
    headingLevel={2}
    items={posts.map((post) => ({
      title: post.data.title,
      summary: post.data.description,
      href: href(`/blog/${post.id}/`),
      meta: formatDate(post.data.published),
      cta: ui.blog.more,
      image: contentImage('blog', post.id),
      ...langOf(post.locale),
    }))}
  />
</ContentPage>
