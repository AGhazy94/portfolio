---
import Page from '../../work/[id].astro';
import { getWork } from '../../../lib/content';
import { isBuilt } from '../../../i18n';

export async function getStaticPaths() {
  if (!isBuilt('ar')) return [];
  return (await getWork('ar'))
    .filter((entry) => entry.locale === 'ar')
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
---

<Page {...Astro.props} />
