---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import NextSteps from '../components/NextSteps.astro';
import { profile, ui } from '../data/profile';
---

<Layout title={`${ui.thanks.title} | ${profile.name}`} noindex>
  <a
    href="#content"
    class="sr-only z-50 rounded-pill bg-fg px-4 py-3 text-sm font-medium text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:px-4! focus:py-3!"
  >
    {ui.skipLink}
  </a>
  <div class="flex min-h-dvh flex-col">
    <Header />
    <main id="content" class="gutter flex-1 py-16 md:py-20">
      <div class="mx-auto w-full max-w-page">
        <Icon name="check" class="size-8 text-accent" />
        <h1 class="type-section mt-6 max-w-[16ch] text-fg">{ui.thanks.heading}</h1>
        <p class="mt-5 max-w-[48ch] text-reading leading-normal text-balance text-body">{ui.thanks.body}</p>
        <NextSteps headingLevel={2} class="mt-10 max-w-[30rem]" />
        <a href="/" class="btn-pill mt-10 min-h-11 bg-fg text-bg">
          {ui.thanks.back}
        </a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
