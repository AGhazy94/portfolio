---
import ContentPage from '../../layouts/ContentPage.astro';
import PageCards from '../../components/PageCards.astro';
import { contentImage, getServices } from '../../lib/content';
import { useCopy } from '../../i18n';

const { profile, ui, locale, href, langOf } = await useCopy(Astro.currentLocale);
const services = await getServices(locale);
const url = new URL(Astro.url.pathname, Astro.site).href;
const nodes = [
  {
    '@type': 'CollectionPage',
    '@id': url,
    url,
    name: ui.services.indexTitle,
    description: ui.services.indexDescription,
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    about: { '@id': new URL('/#person', Astro.site).href },
  },
];
---

<ContentPage
  title={`${ui.services.metaTitle} | ${profile.name}`}
  description={ui.services.indexDescription}
  heading={ui.services.indexHeading}
  nodes={nodes}
  crumbs={[{ label: ui.services.indexTitle }]}
>
  <p>{ui.services.indexLead}</p>
  <PageCards
    slot="after"
    class="mt-10"
    featured
    headingLevel={2}
    items={services.map(({ id, data, locale: entryLocale }) => ({
      title: data.cardTitle,
      summary: data.cardSummary,
      href: href(`/services/${id}/`),
      cta: ui.services.more,
      image: contentImage('services', id),
      ...langOf(entryLocale),
    }))}
  />
</ContentPage>
