---
import { getCollection, render } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import PageCards from '../../components/PageCards.astro';
import { profile, ui } from '../../data/profile';

export async function getStaticPaths() {
  const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
  return services.map((entry) => ({
    params: { id: entry.id },
    props: { entry, others: services.filter((other) => other.id !== entry.id) },
  }));
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const url = new URL(Astro.url.pathname, Astro.site).href;
const articles = (await getCollection('blog'))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 2);
const nodes = [
  {
    '@type': 'WebPage',
    '@id': url,
    url,
    name: data.title,
    description: data.description,
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    dateModified: data.updated.toISOString(),
    mainEntity: { '@id': `${url}#service` },
  },
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: data.cardTitle,
    serviceType: data.cardTitle,
    description: data.description,
    url,
    provider: { '@id': new URL('/#person', Astro.site).href },
    areaServed: 'Worldwide',
  },
];
---

<ContentPage
  title={`${data.title} | ${profile.name}`}
  description={data.description}
  heading={data.heading}
  eyebrow={ui.services.indexTitle}
  nodes={nodes}
  crumbs={[{ label: ui.services.indexTitle, href: '/services/' }, { label: data.cardTitle }]}
  faq={data.faq}
  cta
>
  <Content />
  <Fragment slot="after">
    <section aria-labelledby="related-title" class="mt-20">
      <h2 id="related-title" class="type-project text-fg">
        {ui.page.relatedServices}
      </h2>
      <PageCards
        class="mt-6"
        items={others.map((other) => ({
          title: other.data.cardTitle,
          summary: other.data.cardSummary,
          href: `/services/${other.id}/`,
          cta: ui.services.more,
        }))}
        columns={3}
      />
    </section>
    {articles.length > 0 && (
      <section aria-labelledby="related-articles-title" class="mt-16">
        <h2 id="related-articles-title" class="type-project text-fg">
          {ui.page.relatedArticles}
        </h2>
        <PageCards
          class="mt-6"
          items={articles.map((article) => ({
            title: article.data.title,
            summary: article.data.description,
            href: `/blog/${article.id}/`,
            cta: ui.blog.more,
          }))}
        />
      </section>
    )}
  </Fragment>
</ContentPage>
