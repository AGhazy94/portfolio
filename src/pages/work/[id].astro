---
import { render } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import Icon from '../../components/Icon.astro';
import { contentImage, getWork } from '../../lib/content';
import { useCopy } from '../../i18n';

// src/pages/ar/work/[id].astro renders this page with an Arabic entry.
export async function getStaticPaths() {
  return (await getWork()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: Awaited<ReturnType<typeof getWork>>[number] };

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const { profile, ui, locale, href, langOf } = await useCopy(Astro.currentLocale);
const projects = await getWork(locale);
const next = projects[(projects.findIndex(({ id }) => id === entry.id) + 1) % projects.length]!;
const image = contentImage('work', entry.id);
// The facts row states the role, so the eyebrow keeps only what the product is.
const kind = data.role ? data.kind.split(' · ')[0] : data.kind;
const facts = [
  { label: ui.work.facts.role, value: data.role },
  { label: ui.work.facts.period, value: data.period },
  { label: ui.work.facts.stack, value: data.tags.join(', '), wide: true },
].filter((fact) => fact.value);

const url = new URL(Astro.url.pathname, Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const nodes = [
  {
    '@type': 'WebPage',
    '@id': url,
    url,
    name: data.title,
    description: data.description,
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    dateModified: data.updated.toISOString(),
    about: { '@id': personId },
    author: { '@id': personId, name: profile.name, url: new URL('/', Astro.site).href },
  },
];
---

<ContentPage
  title={`${data.title} | ${profile.name}`}
  description={data.description}
  heading={data.title}
  eyebrow={data.status === 'draft' ? `Draft, dev only · ${kind}` : kind}
  nodes={nodes}
  crumbs={[{ label: ui.work.indexTitle, href: href('/work/') }, { label: data.title }]}
  image={image}
  imageAlt={data.imageAlt}
>
  <div slot="facts" class="mt-10 border-t-2 border-brand pt-6">
    <dl class="grid grid-cols-2 gap-x-8 gap-y-5 md:grid-cols-4">
      {facts.map(({ label, value, wide }) => (
        <div class:list={[wide && 'col-span-2']}>
          <dt class="text-caption text-muted">{label}</dt>
          <dd class="mt-1 text-ui text-pretty text-fg">{value}</dd>
        </div>
      ))}
    </dl>
    {data.href && (
      <a
        href={data.href}
        target="_blank"
        rel="noreferrer noopener"
        class="mt-4 inline-flex min-h-11 items-center gap-1 text-ui font-medium text-accent underline-offset-4 hover:underline"
      >
        {ui.work.visit}
        <span class="sr-only">{ui.newTab}</span>
        <Icon name="external" class="size-4 rtl:-scale-x-100" />
      </a>
    )}
  </div>
  <Content />
  {next.id !== entry.id && (
    <div slot="after" class="mt-16 border-t border-divider pt-8">
      <a href={href(`/work/${next.id}/`)} class="group inline-flex max-w-[44ch] flex-col gap-2">
        <span class="text-caption font-medium text-muted">{ui.work.next}</span>
        <span
          class="type-project text-balance text-fg transition-colors duration-200 group-hover:text-accent"
          {...langOf(next.locale)}
        >
          {next.data.title}
          <Icon name="chevron" class="inline-block size-6 -rotate-90 align-[-2px] rtl:rotate-90" />
        </span>
      </a>
    </div>
  )}
</ContentPage>
