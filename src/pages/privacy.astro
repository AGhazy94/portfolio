---
import ContentPage from '../layouts/ContentPage.astro';
import RichText from '../components/RichText.astro';
import { profile, ui } from '../data/profile';

const { privacy } = ui;
const url = new URL(Astro.url.pathname, Astro.site).href;
const nodes = [
  {
    '@type': 'WebPage',
    '@id': url,
    url,
    name: privacy.heading,
    description: privacy.description,
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
  },
];
const slug = (heading: string) => heading.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<ContentPage
  title={`${privacy.metaTitle} | ${profile.name}`}
  description={privacy.description}
  heading={privacy.heading}
  lead={privacy.lead}
  nodes={nodes}
  crumbs={[{ label: privacy.title }]}
>
  {privacy.sections.map(({ heading, body, storage }) => (
    <>
      <h2 id={slug(heading)}>{heading}</h2>
      {body.map((paragraph) => (
        <RichText source={paragraph} />
      ))}
      {storage && (
        <details class="rounded-field border border-divider">
          <summary class="min-h-11 cursor-pointer px-4 py-3 font-medium text-fg">{storage.summary}</summary>
          <ul class="m-0 list-none divide-y divide-divider border-t border-divider p-0">
            {storage.rows.map((row) => (
              <li class="grid gap-1 px-4 py-3 sm:grid-cols-[minmax(9rem,0.8fr)_minmax(0,2fr)_minmax(7rem,0.7fr)] sm:gap-4">
                <div>
                  <p class="font-medium text-fg">{row.name}</p>
                  <p class="text-[14px] text-muted">{row.provider}</p>
                </div>
                <p>{row.purpose}</p>
                <p>
                  <span class="sr-only">{storage.duration}: </span>
                  {row.duration}
                </p>
              </li>
            ))}
          </ul>
        </details>
      )}
    </>
  ))}
  <p>
    <button
      type="button"
      data-consent-open
      class="hidden min-h-11 js:inline-flex cursor-pointer items-center rounded-pill border border-field-border px-5 text-[15px] font-medium text-fg transition-[opacity,scale] duration-200 hover:opacity-85 motion-safe:active:scale-[0.97]"
    >
      {privacy.change}
    </button>
  </p>
  <p>{privacy.updated}</p>
</ContentPage>
