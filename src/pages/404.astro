---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, ui } from '../data/profile';
---

<Layout title={`${ui.notFound.title} | ${profile.name}`} noindex>
  <a
    href="#content"
    class="sr-only z-50 rounded-pill bg-fg px-4 py-3 text-sm font-medium text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:px-4! focus:py-3!"
  >
    {ui.skipLink}
  </a>
  <div class="flex min-h-dvh flex-col">
    <Header />
    <main id="content" class="gutter flex-1 py-16 md:py-20">
      <div class="mx-auto w-full max-w-page">
        <p class="font-display text-[34px] leading-none text-muted">{ui.notFound.code}</p>
        <h1 class="type-section mt-4 text-fg">{ui.notFound.title}</h1>
        <p class="mt-5 max-w-[48ch] text-reading leading-normal text-body">{ui.notFound.body}</p>
        <a href="/" class="btn-pill mt-10 min-h-11 bg-fg text-bg">
          {ui.notFound.back}
        </a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
