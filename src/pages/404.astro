---
import Layout from '../layouts/Layout.astro';
import { profile, ui } from '../data/profile';
---

<Layout title={`${ui.notFound.title} | ${profile.name}`} noindex>
  <main class="gutter flex min-h-dvh items-center">
    <div class="mx-auto w-full max-w-page">
      <p class="font-display text-[34px] leading-none text-muted">{ui.notFound.code}</p>
      <h1 class="type-section mt-4 text-fg">{ui.notFound.title}</h1>
      <p class="mt-5 max-w-[48ch] text-[17px] leading-normal text-body">{ui.notFound.body}</p>
      <a
        href="/"
        class="mt-10 inline-flex min-h-11 items-center rounded-pill bg-fg px-6.5 text-[15px] font-medium text-bg transition-[opacity,scale] duration-200 hover:opacity-85 motion-safe:active:scale-[0.97]"
      >
        {ui.notFound.back}
      </a>
    </div>
  </main>
</Layout>
